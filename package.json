{
  "name": "leko-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The spotlight you can click through.",
  "license": "MIT",
  "author": "Annetaan Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annetaan/leko.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @annetaan/leko-codegen build && pnpm --filter @leko-examples/sandbox dev",
    "dev:scroll": "pnpm --filter @leko-examples/scroll dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "model": "node scripts/model-check.mjs",
    "model:traces": "node scripts/model-traces.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:reference": "node scripts/check-reference.mjs",
    "check:code-blocks": "node scripts/check-code-blocks.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.32.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
