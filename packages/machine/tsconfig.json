{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // No DOM. This package decides which step a tour is on, and a compile error
    // is the only thing that reliably keeps it from learning what an element is.
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
