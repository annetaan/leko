{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `tsdown` builds this package and reads its options from here. `tsc` must
    // not emit: one file per source file leaves `@annetaan/leko-machine` in the
    // output as an import, and that package is not published. `pnpm check:pack`
    // is the check that catches it; this is the setting that stops it happening
    // by accident.
    "noEmit": true,
    // No ambient `@types` package, so nothing that ships can reach for a global
    // the browser has not got. `tsconfig.test.json` beside this takes Node's
    // types, because the replay reads its corpus off disk, and its `include` is
    // the whole of `src` — so without this line that would be the type
    // environment for every shipped file too, and a `process.env` in
    // `presenter.ts` would compile. `pnpm typecheck` runs both programs for
    // that reason: this one is the one that says what a consumer's browser has.
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
