{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `tsdown` builds this package and reads its options from here. `tsc` must
    // not emit: one file per source file leaves `@annetaan/leko-machine` in the
    // output as an import, and that package is not published. `pnpm check:pack`
    // is the check that catches it; this is the setting that stops it happening
    // by accident.
    "noEmit": true,
    // No ambient `@types` package, so nothing that ships can reach for a global
    // the browser has not got, and a `process.env` in `leko.ts` is a compile
    // error. `tsconfig.test.json` beside this adds Vitest's globals for the
    // tests; `pnpm typecheck` runs both programs, and this one is the one that
    // says what a consumer's browser has.
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
