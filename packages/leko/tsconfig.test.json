{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The replay reads its corpus off disk, so this takes Node's types beside
    // the DOM ones the rest of the package is written against. Only here:
    // `tsconfig.json` is what the build reads, and nothing that ships touches
    // the filesystem.
    "types": ["vitest/globals", "node"],
    // Resolve `@annetaan/leko-machine` and `@annetaan/leko-spotlight` through
    // their `development` export condition, which points at src.
    //
    // Without it this read `dist/index.d.ts`, so the typecheck was answering a
    // question about the last build rather than about the source. Change the
    // machine, skip the build, and `pnpm typecheck` passes against types that
    // no longer exist — which is what it did while `Presenter` was growing a
    // type parameter. Vitest resolves this way, and so do the three type tests
    // beside this file. This was the odd one out.
    //
    // `tsconfig.json` deliberately does not say it. tsdown builds from there
    // and bundles the two halves out of their own `dist`, so the build order
    // `pnpm -r build` already guarantees stays the thing that decides what
    // ships.
    "customConditions": ["development"]
  },
  "include": ["src/**/*"],
  "exclude": []
}
