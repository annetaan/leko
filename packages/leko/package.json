{
  "name": "@annetaan/leko",
  "version": "0.1.0",
  "description": "The spotlight you can click through. Product tours that cut a real hole in the overlay, so the user interacts with your actual UI.",
  "keywords": [
    "onboarding",
    "product-tour",
    "spotlight",
    "tour",
    "tutorial",
    "walkthrough"
  ],
  "homepage": "https://github.com/annetaan/leko",
  "bugs": "https://github.com/annetaan/leko/issues",
  "license": "MIT",
  "author": "Annetaan Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annetaan/leko.git",
    "directory": "packages/leko"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scroll": {
      "development": "./src/scroll.ts",
      "types": "./dist/scroll.d.ts",
      "default": "./dist/scroll.js"
    },
    "./leko.css": "./dist/leko.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./scroll": {
        "types": "./dist/scroll.d.ts",
        "default": "./dist/scroll.js"
      },
      "./leko.css": "./dist/leko.css"
    },
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/publish-with-pnpm.mjs",
    "build": "tsdown && cp node_modules/@annetaan/leko-spotlight/src/leko.css dist/leko.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p type-tests/bare.tsconfig.json && tsc --noEmit -p type-tests/loose.tsconfig.json && tsc --noEmit -p type-tests/strict.tsconfig.json"
  },
  "devDependencies": {
    "@annetaan/leko-machine": "workspace:*",
    "@annetaan/leko-presenter": "workspace:*",
    "@annetaan/leko-scroll": "workspace:*",
    "@annetaan/leko-spotlight": "workspace:*",
    "@annetaan/leko-types": "workspace:*",
    "tsdown": "^0.22.14"
  }
}
