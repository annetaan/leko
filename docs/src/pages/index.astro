---
import { Code } from '@astrojs/starlight/components'
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro'
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'
import logoDark from '../assets/logo-dark.svg'
import logoLight from '../assets/logo-light.svg'
import DarkCode from '../components/DarkCode.astro'
import { href } from '../lib/href.ts'

/**
 * The front page, outside Starlight on purpose: a landing page wants the whole
 * width and a header of its own, and the docs keep Starlight's.
 *
 * Leko Scroll is the only part of Leko that runs here, and scrolling is the
 * only thing it asks of a reader. The Save in 01's hole is a real button, and it
 * answers a click while it is lit because the scrim is paint:
 * [The whole page stays usable](../../../packages/scroll/DESIGN.md#the-whole-page-stays-usable).
 * Leko itself is shown, not run: the playground is where it is touched, and the
 * page offers the way there at the top and at the foot so the reader decides
 * when to go.
 */

const story = `const checkout = {
  id: 'checkout',
  steps: [
    { id: 'cart', target: '#cart', message: 'Your cart.' },
    {
      id: 'pay',
      target: { elements: '#pay', interactive: true },
      message: 'Pay for real. The tour waits.',
      awaits: 'order-saved',
    },
  ],
} satisfies LekoStory`

const reached = `await api.saveOrder(cart)
leko.reached('order-saved')`

const styling = `:root {
  --leko-scrim-color: #000a;
  --leko-halo-outline: 2px solid gold;
  --leko-message-radius: 12px;
}`

const scroll = `import { createScroll } from '@annetaan/leko/scroll'

createScroll({
  targets: [
    { target: '#why-copy' },
    { target: '#why', message: { title: 'A layer, or a hole' } },
    { target: '#signals-copy' },
    { target: '#signals', message: { title: 'No click listener' } },
  ],
})`
---

<!doctype html>
<!-- ThemeProvider rewrites this before first paint, from the same choice the docs keep. -->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Leko — Light the way. Leave the door open.</title>
    <meta
      name="description"
      content="A product tour that cuts a hole in the overlay, so the user works the real element underneath."
    />
    <!-- The docs' three icons, in Starlight's order; docs/astro.config.mjs says why sizes names 32x32 alone. -->
    <link rel="icon" href={href('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <ThemeProvider />
  </head>
  <body>
    <header class="bar">
      <a class="bar-brand" href={href('/')}>
        <img class="logo light" src={logoLight.src} alt="Leko" />
        <img class="logo dark" src={logoDark.src} alt="Leko" />
      </a>
      <nav class="bar-links">
        <a href={href('getting-started/')}>Docs</a>
        <a href={href('playground/')}>Playground</a>
        <a href="https://github.com/annetaan/leko">GitHub</a>
        <ThemeSelect />
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <h1 class="wordmark">
            <img class="logo light" src={logoLight.src} alt="Leko" />
            <img class="logo dark" src={logoDark.src} alt="Leko" />
          </h1>
          <p class="statement">Light the way.<br />Leave the door open.</p>
          <p class="lede">
            The spotlight you can click through. A product tour that cuts a hole in the overlay, so
            your users work the real thing underneath.
          </p>
          <div class="actions">
            <a class="button primary" href={href('getting-started/')}>Get started</a>
            <a class="button" href={href('playground/')}>Try the playground</a>
          </div>
        </div>

        <figure class="hero-art" aria-hidden="true">
          <div class="mock">
            <div class="mock-bar"><span></span><span></span><span></span></div>
            <div class="mock-body">
              <div class="mock-line w60"></div>
              <div class="mock-line w80"></div>
              <div class="mock-field"></div>
              <div class="mock-row">
                <div class="mock-line w30"></div>
                <div class="mock-button lit">Save</div>
              </div>
            </div>
            <svg class="cursor" viewBox="0 0 24 24" width="28" height="28">
              <path d="M4 2l16 10-7 1.5L9.5 21z" />
            </svg>
          </div>
        </figure>

        <p class="scroll-hint">Scroll, and follow the light</p>
      </section>

      <section class="chapter">
        <div class="chapter-body">
          <div class="chapter-copy" id="why-copy">
            <p class="eyebrow">01 · Why another tour</p>
            <h2>Every other tour puts glass over the button.</h2>
            <p>
              A highlight is usually a transparent layer. It looks like the button is right there,
              but the click lands on the layer. So a tour can only point and say “click here”, and
              the user watches.
            </p>
          </div>
          <div class="compare" id="why">
            <div class="compare-card">
              <div class="pane glass">
                <div class="pane-button">Save</div>
                <div class="pane-glass"></div>
              </div>
              <p class="compare-label">A layer <span>the click hits the glass</span></p>
            </div>
            <div class="compare-card">
              <div class="pane hole">
                <button type="button" class="pane-button" id="hole-button">Save</button>
              </div>
              <p class="compare-label">A hole <span>the click hits the button</span></p>
            </div>
          </div>
        </div>
      </section>

      <section class="chapter">
        <div class="chapter-body">
          <div class="chapter-copy" id="signals-copy">
            <p class="eyebrow">02 · Signals</p>
            <h2>A step ends when something really happened.</h2>
            <p>
              Steps never advance on clicks. Your app says what finished, and the step waiting for
              it moves on. A step that waits has no next button, because that would be a way past
              the work it asks for.
            </p>
          </div>
          <div class="codes" id="signals">
            <div class="code-card">
              <p class="code-caption">The story</p>
              <DarkCode><Code code={story} lang="ts" /></DarkCode>
            </div>
            <div class="code-card">
              <p class="code-caption">Your app, where the order really saved</p>
              <DarkCode><Code code={reached} lang="ts" /></DarkCode>
            </div>
          </div>
        </div>
      </section>

      <section class="chapter">
        <div class="chapter-body">
          <div class="chapter-copy" id="typed-copy">
            <p class="eyebrow">03 · Typed signals</p>
            <h2>Typos are caught before anyone runs the tour.</h2>
            <p>
              <code>@annetaan/leko-codegen</code> collects every signal your app reports with <code
                >reached()</code
              > and turns them into a type. A step can only wait for one of them, so a misspelt signal
              is a compile error, not a tour that waits forever.
            </p>
          </div>
          <div class="typed" id="typed">
            <pre><code>{'{ '}<span class="tok-key">id</span>: <span class="tok-str">'pay'</span>, <span class="tok-key">awaits</span>: <span class="tok-str squiggle">'ordr-saved'</span>{' }'}</code></pre>
            <p class="typed-error">
              <span class="typed-badge">TS2322</span>
              Type <code>"ordr-saved"</code> is not assignable to type <code
                >"order-saved" | "profile-filled"</code
              >.
            </p>
          </div>
        </div>
      </section>

      <section class="chapter">
        <div class="chapter-body">
          <div class="chapter-copy" id="tiles-copy">
            <p class="eyebrow">04 · Yours to shape</p>
            <h2>Styled with CSS. Shipped with nothing else.</h2>
            <p>
              Every colour, radius and shadow is a CSS custom property, so the tour looks like your
              app. And Leko has no runtime dependencies at all.
            </p>
          </div>
          <div class="tiles" id="tiles">
            <div class="code-card">
              <p class="code-caption">Your stylesheet</p>
              <DarkCode><Code code={styling} lang="css" /></DarkCode>
            </div>
            <div class="stat">
              <p class="stat-number">0</p>
              <p class="stat-label">runtime dependencies</p>
            </div>
          </div>
        </div>
      </section>

      <section class="chapter reveal">
        <div class="chapter-body">
          <div class="chapter-copy" id="scroll-copy">
            <p class="eyebrow">One more thing</p>
            <h2>The light you followed down this page is Leko, too.</h2>
            <p>
              Leko Scroll is a spotlight for a long page. No story, no steps, nothing to click: the
              light moves as the reader scrolls, and the page underneath stays fully usable. It
              ships in the same package.
            </p>
            <p><a href={href('scroll/getting-started/')}>Get started with Leko Scroll</a></p>
          </div>
          <div class="code-card" id="scroll-code">
            <p class="code-caption">This page, more or less</p>
            <DarkCode><Code code={scroll} lang="ts" /></DarkCode>
          </div>
        </div>
      </section>

      <section class="closing" id="closing">
        <h2>Now try it for real.</h2>
        <p>The playground runs a Leko tour over a real page. Type, click, and watch it wait for you.</p>
        <div class="actions">
          <a class="button primary" href={href('playground/')}>Try the playground</a>
          <a class="button" href={href('getting-started/')}>Get started</a>
        </div>
        <p class="notice">
          Leko is not released yet. Nothing is published beyond a <code>0.0.0</code> placeholder,
          and the API will change.
        </p>
      </section>
    </main>

    <footer class="foot">
      <span>Leko · MIT License</span>
      <a href="https://github.com/annetaan/leko">GitHub</a>
    </footer>

    <script>
      import { createScroll } from '@annetaan/leko/scroll'

      createScroll({
        padding: 16,
        radius: 16,
        halo: 'follow',
        targets: [
          { target: '#why-copy' },
          {
            target: '#why',
            message: {
              title: 'A layer, or a hole',
              body: 'Leko cuts the hole. Press Save: nothing sits between you and the button.',
            },
          },
          { target: '#signals-copy' },
          {
            target: '#signals',
            message: {
              title: 'No click listener',
              body: 'Nothing in Leko moves a step on a DOM event.',
            },
          },
          { target: '#typed-copy' },
          {
            target: '#typed',
            message: {
              title: 'Caught at compile time',
              body: 'A step can only await a name your app reports.',
            },
          },
          { target: '#tiles-copy' },
          {
            target: '#tiles',
            message: { body: 'Every colour on this page’s light is a custom property, too.' },
          },
          { target: '#scroll-copy' },
          {
            target: '#scroll-code',
            message: { title: 'Leko Scroll', body: 'From @annetaan/leko/scroll.' },
          },
          { target: '#closing', padding: 8, radius: 32 },
        ],
      })

      const save = document.querySelector<HTMLButtonElement>('#hole-button')
      const reduced = matchMedia('(prefers-reduced-motion: reduce)')

      save?.addEventListener('click', () => {
        const pane = save.parentElement
        if (!pane || reduced.matches) return
        const x = save.offsetLeft + save.offsetWidth / 2
        const y = save.offsetTop + save.offsetHeight / 2
        // The pane is 150px tall and clips, so a spark flies no further than 80px.
        for (let i = 0; i < 12; i++) {
          const spark = document.createElement('span')
          spark.className = 'spark'
          spark.setAttribute('aria-hidden', 'true')
          spark.textContent = i === 0 ? '✨' : '✦'
          spark.style.left = `${x}px`
          spark.style.top = `${y}px`
          pane.append(spark)
          const angle = Math.random() * 2 * Math.PI
          const radius = 40 + Math.random() * 40
          const dx = Math.cos(angle) * radius
          const dy = Math.sin(angle) * radius
          spark
            .animate(
              [
                { transform: 'translate(0, 0) scale(1)', opacity: 1 },
                { transform: `translate(${dx}px, ${dy}px) scale(0.2)`, opacity: 0 },
              ],
              {
                duration: 500 + Math.random() * 200,
                easing: 'cubic-bezier(.2, .7, .3, 1)',
                fill: 'forwards',
              },
            )
            .finished.then(() => spark.remove())
        }
      })
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f5f0;
    --bg-raised: #ffffff;
    --ink: #16181d;
    --ink-soft: #4a4f5c;
    --ink-faint: #8a8f9c;
    --line: #e3e0d8;
    --accent: #e0a526;
    --accent-ink: #1a1405;
    --code-bg: #0d1117;
    --radius: 16px;

    --leko-scroll-scrim-color: rgb(14 16 22 / 0.55);
    --leko-scroll-halo-outline: 2px solid var(--accent);
    --leko-scroll-message-bg: var(--bg-raised);
    --leko-scroll-message-color: var(--ink);
    --leko-scroll-message-radius: 12px;
    --leko-scroll-message-max-width: min(300px, calc(100vw - 32px));

    color-scheme: light;
  }

  :root[data-theme='dark'] {
    --bg: #0f1115;
    --bg-raised: #1a1d24;
    --ink: #eceae4;
    --ink-soft: #b3b6bf;
    --ink-faint: #7c808c;
    --line: #2a2e37;
    --accent: #f2c14e;
    --leko-scroll-scrim-color: rgb(0 0 0 / 0.62);

    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font:
      17px/1.6 ui-sans-serif,
      system-ui,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  /* The logo is drawn once per theme, as the docs' header does. */
  .logo {
    display: block;
    height: auto;
  }

  :root[data-theme='dark'] .logo.light,
  :root:not([data-theme='dark']) .logo.dark {
    display: none;
  }

  code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.88em;
  }
</style>

<style>
  /* The header ---------------------------------------------------------- */

  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }

  .bar-brand .logo {
    width: auto;
    height: 32px;
  }

  .bar-links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 28px);
    font-size: 15px;
  }

  .bar-links a {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .bar-links a:hover {
    color: var(--ink);
  }

  /* Starlight's global stylesheet reaches this page only when the build happens
     to bundle it in, and never under `astro dev`, so the picker's own rules
     name nothing from it. */
  .bar-links :global(starlight-theme-select label) {
    color: var(--ink-soft);
  }

  .bar-links :global(starlight-theme-select .sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .bar-links :global(starlight-theme-select select) {
    font-size: inherit;
  }

  .bar-links :global(starlight-theme-select option) {
    background: var(--bg-raised);
    color: var(--ink);
  }

  .bar-links :global(starlight-theme-select label:hover) {
    color: var(--ink);
  }

  /* The hero ------------------------------------------------------------ */

  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
    padding: 96px clamp(16px, 6vw, 96px) 72px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .wordmark {
    margin: 0;
  }

  .wordmark .logo {
    width: clamp(240px, 36vw, 440px);
  }

  .statement {
    margin: 20px 0 0;
    font-family: ui-serif, 'Iowan Old Style', Georgia, serif;
    font-style: italic;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .lede {
    margin: 24px 0 0;
    max-width: 34em;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-block;
    padding: 12px 22px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
    font-weight: 600;
    text-decoration: none;
    transition: transform 120ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    margin: 0;
    transform: translateX(-50%);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .scroll-hint::after {
    content: '';
    display: block;
    width: 1px;
    height: 32px;
    margin: 10px auto 0;
    background: linear-gradient(var(--ink-faint), transparent);
  }

  /* A drawing of the idea: a dimmed window with one clear hole. */

  .hero-art {
    margin: 0;
  }

  /* A scrim can only dim what is lighter than itself, and the dark page's
     surface is nearly the scrim's colour already, so the dark drawing is a
     lighter window under a deeper scrim. */
  :global(:root[data-theme='dark']) .mock {
    --mock-surface: #5a606d;
    --mock-line: #7a8190;
    --mock-scrim: rgb(0 0 0 / 0.6);
  }

  .mock {
    --mock-surface: var(--bg-raised);
    --mock-line: var(--line);
    --mock-scrim: rgb(14 16 22 / 0.62);

    position: relative;
    border-radius: var(--radius);
    background: var(--mock-surface);
    border: 1px solid var(--mock-line);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .mock-bar {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--mock-line);
  }

  .mock-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--mock-line);
  }

  .mock-body {
    display: grid;
    gap: 14px;
    padding: 28px;
  }

  .mock-line {
    height: 10px;
    border-radius: 5px;
    background: var(--mock-line);
  }

  .w30 {
    width: 30%;
  }
  .w60 {
    width: 60%;
  }
  .w80 {
    width: 80%;
  }

  .mock-field {
    height: 40px;
    border: 1px solid var(--mock-line);
    border-radius: 8px;
  }

  .mock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
  }

  .mock-button {
    padding: 10px 22px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 15px;
  }

  /* The hole: the button's own shadow dims everything around it. */
  .mock-button.lit {
    position: relative;
    z-index: 1;
    box-shadow:
      0 0 0 10px var(--mock-surface),
      0 0 0 2000px var(--mock-scrim);
  }

  .cursor {
    position: absolute;
    z-index: 2;
    right: 44px;
    bottom: 12px;
    fill: #fff;
    stroke: #16181d;
    stroke-width: 1.5;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.4));
  }

  /* Chapters ------------------------------------------------------------ */

  .chapter {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(96px, 16vh, 180px) clamp(16px, 6vw, 96px);
  }

  .chapter-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: start;
    column-gap: clamp(32px, 6vw, 88px);
    row-gap: 32px;
  }

  .chapter-body > :not(.chapter-copy) {
    grid-column: 2;
    grid-row: 2;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h2 {
    margin: 0;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .chapter-copy p:not(.eyebrow) {
    margin: 20px 0 0;
    color: var(--ink-soft);
  }

  /* 01: a layer, or a hole. */

  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .compare-card {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }

  .pane {
    position: relative;
    display: grid;
    place-items: center;
    height: 150px;
    border-radius: 10px;
    background: repeating-linear-gradient(
      -45deg,
      var(--bg),
      var(--bg) 8px,
      transparent 8px,
      transparent 16px
    );
    overflow: hidden;
  }

  .pane-button {
    padding: 10px 22px;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-ink);
    font: inherit;
    font-weight: 700;
    cursor: default;
  }

  .pane.hole .pane-button {
    cursor: pointer;
    transition:
      background 120ms,
      transform 120ms,
      box-shadow 120ms;
  }

  .pane.hole .pane-button:hover {
    background: color-mix(in srgb, var(--accent) 85%, white);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -6px var(--accent);
  }

  .pane.hole .pane-button:active {
    transform: translateY(0) scale(0.97);
  }

  .pane.hole .pane-button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* A spark is made by the script, so it carries no scoped-style attribute. */
  .pane :global(.spark) {
    position: absolute;
    pointer-events: none;
    color: var(--accent);
    font-size: 14px;
    line-height: 1;
    translate: -50% -50%;
    will-change: transform, opacity;
  }

  .pane-glass {
    position: absolute;
    inset: 20px 30px;
    border-radius: 10px;
