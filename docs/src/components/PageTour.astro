---
/**
 * A Leko tour over this page.
 *
 * The point of it is what it points at. The sidebar, or the menu button that
 * opens it on a narrow screen, and the code block below belong to the site,
 * not to a demo widget, and the input inside the cutout is
 * typed into while the scrim is up. A tour in an iframe could not show either.
 * The tour can also arrive here from What Leko is, handed on across the
 * page load — `pickUp` below is the other way in.
 */
---

<div class="tour-demo" data-tour-demo>
  <button class="tour-start" type="button" data-tour-start>Start the tour</button>

  <div class="tour-name" data-tour-name>
    <label class="tour-field">
      Your name
      <input type="text" data-tour-input placeholder="type anything" />
    </label>
    <button class="tour-save" type="button" data-tour-save>Save</button>
    <span class="tour-saved" data-tour-saved aria-live="polite"></span>
  </div>

  <p class="tour-status" data-tour-status>No tour running.</p>
</div>

<script>
  import { createLeko } from '@annetaan/leko'
  import '@annetaan/leko/leko.css'
  import type { LekoStory } from '@annetaan/leko'
  import { SIDEBAR_SHOWN, desktopIntro, introFor, mobileIntro } from '../lib/stories.ts'

  const demo = document.querySelector<HTMLElement>('[data-tour-demo]')
  if (demo) {
    const status = demo.querySelector<HTMLElement>('[data-tour-status]')!
    const input = demo.querySelector<HTMLInputElement>('[data-tour-input]')!
    const save = demo.querySelector<HTMLButtonElement>('[data-tour-save]')!
    const saved = demo.querySelector<HTMLElement>('[data-tour-saved]')!

    // Never stale: pickUp() below runs once, before any click can be
    // delivered, so a handed-on run always sees this false.
    let pressedStart = false

    const intros: readonly LekoStory[] = [desktopIntro, mobileIntro]

    const leko = createLeko({
      onStep: (step, story) => {
        if (!step) {
          status.textContent = 'The tour is over. Everything you did to the page stayed done.'
        } else if (intros.includes(story) && !pressedStart) {
          status.textContent =
            `${story.id}: “${step.id}” — it began with this page load; ` +
            'nothing here was pressed.'
        } else {
          status.textContent = `${story.id}: “${step.id}”`
        }
      },
    })

    // The page's own save; `reached()` after it is the one line the tour adds.
    save.addEventListener('click', async () => {
      if (input.value.trim() === '') {
        saved.textContent = 'Type a name first.'
        return
      }
      save.disabled = true
      saved.textContent = 'Saving…'
      await new Promise((resolve) => setTimeout(resolve, 500))
      saved.textContent = 'Saved.'
      save.disabled = false
      leko.reached('name-saved')
    })

    demo.querySelector('[data-tour-start]')!.addEventListener('click', () => {
      pressedStart = true
      leko.start(introFor())
    })

    // An intro points at what only one side of the breakpoint shows, so a
    // crossing while one stands starts the other. Past the intro, every
    // target shows at both widths and the tour is left alone.
    matchMedia(SIDEBAR_SHOWN).addEventListener('change', () => {
      const { story } = leko
      if (story && intros.includes(story)) {
        leko.stop()
        leko.start(introFor())
      }
    })

    // Once per document: takes what What Leko is handed on, or nothing.
    leko.pickUp([desktopIntro, mobileIntro])
  }
</script>

<style>
  .tour-name {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.5rem;
  }

  .tour-field {
    display: grid;
    gap: 0.25rem;
    font-size: var(--sl-text-sm);
  }

  .tour-field input {
    font: inherit;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }

  .tour-save {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .tour-saved {
    width: 18ch;
    white-space: nowrap;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .tour-status {
    flex-basis: 100%;
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    /* examples/sandbox/src/cases/across-a-page-load.ts has the same cure,
       and argues why a box above a target must not change height. Sized
       for the two-line sentence the narrow intro reports when picked up
       from What Leko is; leaves a one-line residual below about 338px. */
    min-height: 2lh;
  }
</style>
