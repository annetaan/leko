---
import { href } from '../lib/href.ts'

/**
 * The other end of the crossing PageTour.astro completes.
 *
 * The link below is what `toPlayground`'s one step targets — see stories.ts
 * for why. The story itself names `next` — DESIGN.md, **A page load ends
 * the story, and hands it on**.
 */
---

<div class="tour-demo" data-site-tour-demo>
  <button class="tour-start" type="button" data-site-tour-start
    >Take the tour to the playground</button
  >
  <a href={href('playground/')} data-site-tour-link>Playground</a>
</div>

<script>
  import { createLeko } from '@annetaan/leko'
  import '@annetaan/leko/leko.css'
  import { toPlayground } from '../lib/stories.ts'

  const leko = createLeko()

  document
    .querySelector('[data-site-tour-start]')!
    .addEventListener('click', () => {
      leko.start(toPlayground)
    })

  // No story hands on to this one, so this call only takes away a note an
  // earlier page left behind.
  leko.pickUp([toPlayground])
</script>
